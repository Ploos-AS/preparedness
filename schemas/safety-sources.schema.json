{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ploos.no/schemas/preparedness/safety-sources.schema.json",
  "title": "Ploos Preparedness safety source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "authority", "title", "url", "verified_on", "review_due"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "authority": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "verified_on": {"type": "string", "format": "date"},
          "review_due": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
