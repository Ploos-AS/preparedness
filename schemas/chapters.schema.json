{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ploos.no/schemas/preparedness/chapters.schema.json",
  "title": "Ploos Preparedness chapter manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chapters"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "no",
          "en",
          "parity",
          "parity_revision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "no": {
            "type": "string",
            "pattern": "^no/.+\\.md$"
          },
          "en": {
            "type": "string",
            "pattern": "^en/.+\\.md$"
          },
          "parity": {
            "const": "required"
          },
          "hazards": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "backfeed",
                "battery",
                "carbon_monoxide",
                "combustion",
                "electric_shock",
                "fire",
                "fuel_storage",
                "ventilation"
              ]
            }
          },
          "safety_sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "parity_revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
